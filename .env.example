# Copy this file to .env and fill in the values. .env is git-ignored.

# Yahoo app credentials from https://developer.yahoo.com/apps
# (Confidential Client, "Fantasy Sports - Read", redirect URI https://localhost:8080)
YAHOO_CONSUMER_KEY=
YAHOO_CONSUMER_SECRET=

# Written automatically by `npm run yahoo:login`. Do not edit by hand.
YAHOO_ACCESS_TOKEN_JSON=

# League ID from https://basketball.fantasysports.yahoo.com/nba/<league id>
YAHOO_LEAGUE_ID=38764
